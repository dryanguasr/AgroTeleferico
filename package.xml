<?xml version="1.0"?>
<package format="3">
  <name>agro_teleferico</name><version>0.1.0</version>
  <description>Piloto agrícola de robots suspendidos por cables.</description>
  <maintainer email="dryanguasr@users.noreply.github.com">dryanguasr</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gz_sim_vendor</depend><depend>gz_plugin_vendor</depend><depend>eigen</depend>
  <exec_depend>rclpy</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <depend>rclcpp</depend><depend>std_msgs</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pil</exec_depend><exec_depend>ffmpeg</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
